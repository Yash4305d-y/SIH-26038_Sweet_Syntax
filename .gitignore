# Model Weights & Checkpoints

# -------------------------

*.pt
*.pth
*.ckpt
*.onnx

# Ignore MATLAB model files by default

models/*.mat
modules/**/models/*.mat
modules/**/model/*.mat

# LOCKED FINAL ML MODEL

!models/baseline_resnet50_smoketest.mat

# -------------------------

# Generated Model Outputs

# -------------------------

outputs/gradcam/
outputs/predictions/
outputs/checkpoints/

# -------------------------

# Evaluation Artifacts

# -------------------------

# Ignore evaluation artifacts by default

outputs/evaluation/*

# CONTROLLED ADAPTATION — required machine-readable contract

!outputs/evaluation/adaptation_handoff_package.json

# REFERABLE DR — required calibration artifact

!outputs/evaluation/referable_dr/
!outputs/evaluation/referable_dr/calibration/
!outputs/evaluation/referable_dr/calibration/calibration_parameters.mat

# MACHINE-READABLE MASTER RESULTS

!outputs/evaluation/ml_master/

# -------------------------

# MATLAB .mat Files

# -------------------------

# Ignore generated/simulation .mat files

modules/simulink_telemed/results/*.mat
outputs/**/*.mat

# Re-allow explicitly required tracked artifacts

!models/baseline_resnet50_smoketest.mat
!outputs/evaluation/adaptation_handoff_package.json
!outputs/evaluation/referable_dr/calibration/calibration_parameters.mat

