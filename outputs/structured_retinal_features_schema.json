{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Member3StructuredRetinalFeatures",
  "type": "object",
  "description": "Authoritative machine-readable structured retinal feature extraction interface provided by Member 3 for Role 1 / Dashboard integration.",
  "required": [
    "case_id",
    "timestamp",
    "iqa",
    "preprocessing",
    "structures",
    "lesion_candidates"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique identifier for the patient/fundus image case."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "iqa": {
      "type": "object",
      "required": ["status", "focus_metric", "illumination_metric", "fov_area_ratio", "recapture_guidance"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL"]
        },
        "focus_metric": {
          "type": "number",
          "description": "Laplacian variance focus score."
        },
        "illumination_metric": {
          "type": "number",
          "description": "Mean green-channel illumination intensity."
        },
        "fov_area_ratio": {
          "type": "number",
          "description": "Ratio of non-zero circular FOV pixels relative to total image area."
        },
        "recapture_guidance": {
          "type": "string",
          "description": "Actionable feedback for healthcare worker if IQA fails."
        }
      }
    },
    "preprocessing": {
      "type": "object",
      "required": ["clahe_applied", "denoising_applied", "target_dimensions"],
      "properties": {
        "clahe_applied": { "type": "boolean" },
        "denoising_applied": { "type": "boolean" },
        "target_dimensions": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "structures": {
      "type": "object",
      "required": ["vessel_density", "optic_disc", "fovea"],
      "properties": {
        "vessel_density": {
          "type": "number",
          "description": "Percentage of segmented retinal vessel pixels over FOV area."
        },
        "optic_disc": {
          "type": "object",
          "required": ["detected", "centroid_xy", "radius_px"],
          "properties": {
            "detected": { "type": "boolean" },
            "centroid_xy": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "radius_px": { "type": "number" }
          }
        },
        "fovea": {
          "type": "object",
          "required": ["detected", "centroid_xy"],
          "properties": {
            "detected": { "type": "boolean" },
            "centroid_xy": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "lesion_candidates": {
      "type": "object",
      "required": ["microaneurysms", "exudates", "hemorrhages", "neovascularization"],
      "properties": {
        "microaneurysms": {
          "type": "object",
          "required": ["candidate_count", "status"],
          "properties": {
            "candidate_count": { "type": "integer" },
            "status": { "type": "string", "enum": ["PARTIALLY VALIDATED"] }
          }
        },
        "exudates": {
          "type": "object",
          "required": ["candidate_count", "status"],
          "properties": {
            "candidate_count": { "type": "integer" },
            "status": { "type": "string", "enum": ["PARTIALLY VALIDATED"] }
          }
        },
        "hemorrhages": {
          "type": "object",
          "required": ["candidate_count", "status"],
          "properties": {
            "candidate_count": { "type": "integer" },
            "status": { "type": "string", "enum": ["PARTIALLY VALIDATED"] }
          }
        },
        "neovascularization": {
          "type": "object",
          "required": ["status", "scope_note"],
          "properties": {
            "status": { "type": "string", "enum": ["NOT IMPLEMENTED"] },
            "scope_note": { "type": "string" }
          }
        }
      }
    }
  }
}
